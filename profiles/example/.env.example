# Copy to .env next to baton.yaml and fill in. Baton reads these from the
# process environment; it never stores a credential in a config file.
#
# Only the variables for the drivers you actually enable need values —
# `baton doctor` tells you which those are.

# --- Session documents -----------------------------------------------------
# Notion internal integration token, from notion.so/my-integrations.
# Share the session database with the integration or every call 404s.
NOTION_API_TOKEN=

# --- Messaging -------------------------------------------------------------
# Telegram: create a bot with @BotFather.
TELEGRAM_BOT_TOKEN=
# Chat ids of your recipients (a number for a person, negative for a group).
BATON_CONTACT_ME=
BATON_CONTACT_MANAGER=

# LINE, if chat.driver is `line`. The token is a channel access token from the
# LINE Developers console; ids are the platform user ids, not display names.
# LINE_CHANNEL_ACCESS_TOKEN=

# Generic webhook, if chat.driver is `webhook`.
# BATON_WEBHOOK_URL=
# BATON_WEBHOOK_SECRET=

# --- Learner records, if db.driver is supabase -----------------------------
# SUPABASE_PROJECT_URL=
# SUPABASE_PROJECT_API=

# --- Video, if you use `baton video` ---------------------------------------
# BATON_DRIVE_FOLDER_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
